# Benchmark artefacts are EVIDENCE, not source. The 27 MB GridAtlas teleprint
# these benches were measured on is deliberately not committed; neither is any
# stand-in generated by claude/make-sample-artefact.mjs.
sample-artefact.txt
*teleprint*.txt
*teleprint*.pdf
*.teleprint

# Output written by claude/analyse-corpus-gpu.mjs --out. The committed copy of
# a run lives in claude/results/ under a timestamped name; a fresh local run
# should not silently overwrite or shadow it.
gpu-analysis/

# Large evidence dumps generally
evidence/
*.dump.txt

node_modules/
npm-debug.log*
